#!/usr/bin/env bash
# the-office's own pre-commit sensor. Installed with:
#   git config core.hooksPath .githooks
#
# Fast controls only. Anything slower than a couple of seconds gets bypassed
# with --no-verify, which is worse than having no hook at all.
set -euo pipefail

fail=0

# The CLI is the whole deterministic core — a syntax error here breaks every role.
if ! node --check payload/bin/office.mjs; then
  echo "pre-commit: payload/bin/office.mjs does not parse" >&2
  fail=1
fi

# A malformed pack manifest fails silently at install time, which is the worst
# possible moment to find out.
for f in packs/*/pack.json; do
  node -e "JSON.parse(require('fs').readFileSync('$f','utf8'))" 2>/dev/null || {
    echo "pre-commit: $f is not valid JSON" >&2; fail=1; }
done

# Version drift is cheap to catch here and expensive to catch after a tag.
V="$(cat VERSION)"
if ! grep -q "^const VERSION = '$V';$" payload/bin/office.mjs; then
  echo "pre-commit: VERSION ($V) does not match the constant in office.mjs -- run scripts/bump.sh" >&2
  fail=1
fi
if ! node -e "process.exit(require('./package.json').version === '$V' ? 0 : 1)"; then
  echo "pre-commit: VERSION ($V) does not match package.json -- run scripts/bump.sh" >&2
  fail=1
fi

# The board's own sensor, when the board changed.
# Capture before matching: `grep -q` exits on first hit, and with pipefail a
# SIGPIPE'd `git diff` would surface as a spurious failure.
staged="$(git diff --cached --name-only)"
if printf '%s\n' "$staged" | grep -q '^\.the-office/'; then
  node payload/bin/office.mjs validate || fail=1
fi

exit $fail
