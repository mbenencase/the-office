#!/usr/bin/env bash
# Warn when a commit subject is not a Conventional Commit.
#
# Deliberately advisory, not blocking. The release version is derived from these
# subjects, so a wrong prefix produces a wrong version number -- but blocking a
# commit over a message is the kind of friction that gets hooks disabled, and a
# disabled hook catches nothing.
#
# Types: feat fix perf refactor revert docs test ci build chore style
#   feat: ...            -> minor
#   fix: ...             -> patch
#   feat!: / BREAKING CHANGE: in the body -> major
set -uo pipefail

msg_file="$1"
subject="$(head -1 "$msg_file")"

# Merges, reverts, fixups and squashes are generated by git; leave them alone.
case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *|"") exit 0 ;;
esac

if printf '%s\n' "$subject" | grep -qE '^[a-z]+(\([^)]+\))?!?: .+'; then
  exit 0
fi

printf '\033[33mcommit-msg\033[0m subject is not a Conventional Commit:\n' >&2
printf '  %s\n\n' "$subject" >&2
printf '  Release versions are derived from these. Without a type prefix this\n' >&2
printf '  commit counts as a patch and lands under "Changed" in the notes.\n\n' >&2
printf '  feat: add X       minor      fix: correct Y      patch\n' >&2
printf '  feat!: drop Z     major      chore: tidy W       patch, grouped Internal\n\n' >&2
printf '  Committing anyway.\n' >&2
exit 0
